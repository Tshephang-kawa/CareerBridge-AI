rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 2. Strict User Isolation: A user can only access their own profile and personal subcollections
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId);

      // Subcollections: CV, Saved Jobs, Applications, Planner Tasks, AI History
      match /cv/{cvDoc} {
        allow read, write: if isOwner(userId);
      }

      match /savedJobs/{jobId} {
        allow read, write: if isOwner(userId);
      }

      match /applications/{applicationId} {
        allow read, write: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /chatHistory/{chatId} {
        allow read, write: if isOwner(userId);
      }

      match /researchHistory/{reportId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
